# Public Supabase values for the browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values must never be committed with real secrets.
# Add them in Vercel Environment Variables when required.
SUPABASE_SERVICE_ROLE_KEY=

# Project-cost extensions are disabled until their reviewed Supabase drafts are explicitly migrated.
PROJECT_COST_BRIDGE_ENABLED=false
PROJECT_COST_FORECAST_ENABLED=false
PROJECT_COST_PAYMENT_LINK_ENABLED=false
PROJECT_PROGRESS_VALUATION_ENABLED=false

# Transaction Intelligence runs through Vercel AI Gateway.
# Vercel deployments authenticate with OIDC automatically; use an API key locally.
TRANSACTION_INTELLIGENCE_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_API_KEY=
