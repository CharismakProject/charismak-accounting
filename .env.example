# Public Supabase values for the browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values must never be committed with real secrets.
# Add them in Vercel Environment Variables when required.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction Intelligence runs through Vercel AI Gateway.
# Vercel deployments authenticate with OIDC automatically; use an API key locally.
TRANSACTION_INTELLIGENCE_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_API_KEY=
